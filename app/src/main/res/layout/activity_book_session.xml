<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#578974"
    tools:context=".BookSessionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header consistent with other screens -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:padding="10dp"
                app:tint="#EFEBEB" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/roboto"
                android:text="Available Slots"
                android:textColor="#EFEBEB"
                android:textSize="28sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/cal_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <include
                        android:id="@+id/calendarHeader"
                        layout="@layout/item_calendar_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="S" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="M" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="T" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="W" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="T" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="F" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:gravity="center"
                            android:text="S" android:textSize="12sp"
                            android:textColor="@color/cal_abbrev_label" android:textStyle="bold"/>
                    </LinearLayout>

                    <com.kizitonwose.calendar.view.CalendarView
                        android:id="@+id/calendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cv_dayViewResource="@layout/item_calendar_day" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ListView
                android:id="@+id/listViewSessions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookSession"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto"
                android:text="Book Session"
                android:textAllCaps="false"
                android:textColor="#567D6A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#BED2D0"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_book_custom"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#567D6A" />

        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
