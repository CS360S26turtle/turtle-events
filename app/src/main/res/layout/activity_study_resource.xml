<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_study_resource.xml
    Screen for a tutor to manage study resources for one student.
    FAB is placed inside a FrameLayout overlay so it floats above the list.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <!-- FrameLayout wraps everything so the FAB can float over the list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#578974">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="#4A7563">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#EFEBEB"
                    android:contentDescription="Back" />

                <TextView
                    android:id="@+id/tv_toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Study Resources"
                    android:textColor="#EFEBEB"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Student name banner -->
            <TextView
                android:id="@+id/tv_student_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:text="Student: —"
                android:textColor="#C8D6CF"
                android:textSize="14sp"
                android:textStyle="italic" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A7563"
                android:layout_marginHorizontal="16dp" />

            <!-- Resource list -->
            <ListView
                android:id="@+id/list_resources"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="80dp" />

            <!-- Empty state (shown when list is empty) -->
            <TextView
                android:id="@+id/tv_empty_resources"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="No resources yet."
                android:textColor="#C8D6CF"
                android:textSize="15sp"
                android:textAlignment="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- FAB floats over the list in the bottom-end corner -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_resource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@drawable/ic_add_custom"
            app:backgroundTint="#C8D6CF"
            app:tint="#578974"
            android:contentDescription="Add resource" />

    </FrameLayout>

    <!-- ── Nav drawer (tutor menu) ────────────────────────────────────────── -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        app:elevation="0dp">
        <FrameLayout
            android:id="@+id/menu_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>