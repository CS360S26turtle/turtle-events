<?xml version="1.0" encoding="utf-8"?>
<!--
    item_study_resource.xml
    Single row in the StudyResourceActivity's ListView.
    Shows: type chip | title | content preview | delete button
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#C8D6CF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Type badge -->
        <TextView
            android:id="@+id/tv_resource_type"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textColor="#EFEBEB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/shape_resource_type_badge"
            android:text="NOTE" />

        <!-- Title + content preview -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_resource_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resource title"
                android:textColor="#00332B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_resource_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Content preview…"
                android:textColor="#578974"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Delete button -->
        <ImageView
            android:id="@+id/btn_delete_resource"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#C0392B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete resource" />

    </LinearLayout>

</androidx.cardview.widget.CardView>