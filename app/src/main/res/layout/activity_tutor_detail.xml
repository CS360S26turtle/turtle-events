<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_background"
    android:padding="24dp">

    <!-- Top Bar with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="User Detail"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- User ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User ID:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/detailUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User ID"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/detailEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <!-- Subjects (New) -->
            <TextView
                android:id="@+id/labelSubjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applied Subjects:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/detailSubjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subjects"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- Transcript Placeholder (New) -->
            <TextView
                android:id="@+id/labelTranscript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transcript:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"
                android:visibility="gone"/>
            <ImageView
                android:id="@+id/detailTranscript"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:background="#33FFFFFF"
                android:visibility="gone"/>

            <!-- Role -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/detailRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <!-- Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status:"
                android:textColor="#A8C8B6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/ACCEPT_BUTTON"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Approve"
        android:backgroundTint="#FFFFFF"
        android:textColor="#4a7c6f"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/REJECT_BUTTON"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reject"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"/>

</LinearLayout>