<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_my_students.xml
    Shows the tutor a list of students who have booked sessions with them.
    Tapping a student opens StudyResourceActivity for that student.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#578974">

        <!-- Toolbar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#4A7563">

            <ImageView
                android:id="@+id/btn_hamburger"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#EFEBEB"
                android:contentDescription="Menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="My Students"
                android:textColor="#EFEBEB"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="Tap a student to manage their study resources"
            android:textColor="#C8D6CF"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Student list -->
        <ListView
            android:id="@+id/list_students"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/tv_empty_students"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No students yet.\nStudents will appear here once they book a session with you."
            android:textColor="#C8D6CF"
            android:textSize="15sp"
            android:textAlignment="center"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Nav drawer ─────────────────────────────────────────────────────── -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        app:elevation="0dp">
        <FrameLayout
            android:id="@+id/menu_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp" />
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>